{
  "name": "saunahop-tiktok",
  "private": true,
  "type": "module",
  "description": "Makes a daily TikTok post for saunahop.com from the venue and availability data.",
  "scripts": {
    "build": "node build.mjs",
    "post": "node post.mjs",
    "dry-run": "node post.mjs --dry-run",
    "channels": "node post.mjs --channels",
    "setup": "playwright install chromium"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.58.2"
  }
}
